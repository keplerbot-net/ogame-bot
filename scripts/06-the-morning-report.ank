// The morning report
//
// Once a day, what the account did overnight.
//
// Explained in full: https://keplerbot.net/en/scripts/examples#recettes--6-the-morning-report
// Kepler OGame bot: https://keplerbot.net/en

fmt = import("fmt")

CronExec("@08h00", func() {
	c = GetCachedCelestials()
	year, month, day = Date()
	lines = fmt.Sprintf("report for %d/%d/%d\n", day, month, year)

	total = 0
	for i = 0; i < len(c); i++ {
		res, err = GetResources(c[i].GetID())
		if err != nil {
			continue
		}
		total = total + res.Metal + res.Crystal + res.Deuterium
		Sleep(500)                  // do not chain reads back to back
	}

	colonies, possible = CountColonies()
	lines = lines + fmt.Sprintf("%d celestials, %d/%d colonies\n", len(c), colonies, possible)
	lines = lines + fmt.Sprintf("resources in store: %d\n", total)

	reports, err = GetEspionageReportMessages()
	if err == nil {
		lines = lines + fmt.Sprintf("%d espionage reports in the box\n", len(reports))
	}

	SendDiscord(DISCORD_WEBHOOK, lines)
})

<-OnQuitCh
